# Apex WSGTA automation: example environment. DRY-RUN ONLY.
# Copy to .env.apex (gitignored) and fill in only what you use.
# --offline runs need none of this.

# Which role->model profile to start from: "local" (Ollama, no keys) or "cloud".
APEX_LLM_PROFILE=local

# Ollama endpoint (upstream TradingAgents honours OLLAMA_BASE_URL).
OLLAMA_BASE_URL=http://localhost:11434/v1

# Per-role overrides: APEX_ROLE_<ROLE>_PROVIDER / _MODEL / _BASE_URL
# Roles: TECHNICAL, MACRO_NEWS, SENTIMENT, BULL, BEAR, RESEARCH_MANAGER, RISK_NARRATIVE, PORTFOLIO_MANAGER
# Providers: any TradingAgents provider (openai, anthropic, google, openrouter, ollama,
# openai_compatible, xai, deepseek, ...) or "stub" (no model).
# APEX_ROLE_BULL_PROVIDER=openrouter
# APEX_ROLE_BULL_MODEL=nousresearch/hermes-4-405b
# APEX_ROLE_BEAR_PROVIDER=openrouter
# APEX_ROLE_BEAR_MODEL=qwen/qwen3-235b-a22b
# APEX_ROLE_MACRO_NEWS_PROVIDER=openai_compatible
# APEX_ROLE_MACRO_NEWS_MODEL=sonar-pro
# APEX_ROLE_MACRO_NEWS_BASE_URL=https://api.perplexity.ai

# Provider keys (only for the providers you select). Placeholders, never commit real keys.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# Perplexity via the openai_compatible provider reads this variable:
# OPENAI_COMPATIBLE_API_KEY=
